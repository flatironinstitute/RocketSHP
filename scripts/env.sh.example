#!/usr/bin/env bash
# Copy this file to scripts/env.sh and set values for your cluster environment.
# Then source it before running training/preprocessing scripts, or let each
# script pick up the exported variables from your shell environment.
#
# Usage:
#   cp scripts/env.sh.example scripts/env.sh
#   # Edit scripts/env.sh to match your cluster setup
#   source scripts/env.sh
#
# Alternatively, export these variables in your ~/.bashrc / ~/.zshrc:
#   export PLANET_MD_DIR=$HOME/PLANET-MD
#   export PLANET_MD_VENV=$HOME/venvs/planet-md

# Absolute path to the PLANET-MD project directory
export PLANET_MD_DIR=${PLANET_MD_DIR:-$HOME/PLANET-MD}

# Absolute path to the Python virtual environment to activate.
# Defaults to .venv inside the project directory.
export PLANET_MD_VENV=${PLANET_MD_VENV:-$PLANET_MD_DIR/.venv}
